APP_NAME=Decisionops
ENV=dev

DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/decisionops

DO_SESSION_SECRET=your-secret-key-here-longer-than-32-characters

# Request and dataset resource limits.
# Values are in bytes unless otherwise noted.
MAX_REQUEST_BYTES=3145728
MAX_UPLOAD_BYTES=2097152

MAX_DATASET_ROWS=5000
MAX_DATASET_COLUMNS=50
MAX_CELL_CHARS=2000

MAX_DATASET_NAME_CHARS=100
MAX_FILENAME_CHARS=255

# Optimization resource limits.
MAX_OPTIMIZATION_ROWS=5000
MAX_MAX_ITEMS=5000

DEFAULT_SOLVER_TIME_S=5
MAX_SOLVER_TIME_S=10
MAX_SOLVER_WORKERS=2

MAX_GLOBAL_OPTIMIZATIONS=1

# Maximum absolute magnitude accepted for business numeric values.
MAX_NUMERIC_VALUE=1000000000000