APP_NAME=DecisionOps
ENV=dev

DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/decisionops


# -------------------------------------------------------------------
# Session security
# -------------------------------------------------------------------

# Required. Must be at least 32 characters.
#
# Never use this example value in production.
# Generate a cryptographically random secret with:
#
# python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Changing this value invalidates all existing signed session cookies.
DO_SESSION_SECRET=your-secret-key-here-longer-than-32-characters


# -------------------------------------------------------------------
# Browser/request boundary
# -------------------------------------------------------------------

# Comma-separated browser origins allowed to make credentialed requests.
# Do not use "*".
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://decisionops.vsinghania.dev,https://decisionops.onrender.com

# Comma-separated HTTP Host values DecisionOps will serve.
# Do not include schemes or paths, and do not use "*".
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,decisionops.vsinghania.dev,decisionops.onrender.com


# -------------------------------------------------------------------
# Request and dataset resource limits
# -------------------------------------------------------------------

# Maximum complete HTTP request size in bytes.
MAX_REQUEST_BYTES=3145728

# Maximum uploaded CSV content size in bytes.
MAX_UPLOAD_BYTES=2097152

MAX_DATASET_ROWS=5000
MAX_DATASET_COLUMNS=50
MAX_CELL_CHARS=2000

MAX_DATASET_NAME_CHARS=100
MAX_FILENAME_CHARS=255


# -------------------------------------------------------------------
# Optimization resource limits
# -------------------------------------------------------------------

MAX_OPTIMIZATION_ROWS=5000
MAX_MAX_ITEMS=5000

DEFAULT_SOLVER_TIME_S=5
MAX_SOLVER_TIME_S=10
MAX_SOLVER_WORKERS=2

MAX_GLOBAL_OPTIMIZATIONS=1

# Maximum absolute magnitude accepted for business numeric values.
MAX_NUMERIC_VALUE=1000000000000


# -------------------------------------------------------------------
# Rate limiting
# -------------------------------------------------------------------

# Maximum number of rate-limit buckets held in process memory.
MAX_RATE_LIMIT_BUCKETS=10000


# Signup: client-IP based.
# Default: 5 requests per 15 minutes.
SIGNUP_RATE_LIMIT_REQUESTS=5
SIGNUP_RATE_LIMIT_WINDOW_S=900


# Login: client-IP based.
# Default: 10 requests per 5 minutes.
LOGIN_RATE_LIMIT_REQUESTS=10
LOGIN_RATE_LIMIT_WINDOW_S=300


# Dataset upload: authenticated-user based.
# Default: 10 requests per hour.
UPLOAD_RATE_LIMIT_REQUESTS=10
UPLOAD_RATE_LIMIT_WINDOW_S=3600


# Dataset preview: authenticated-user based.
# Default: 60 requests per 5 minutes.
PREVIEW_RATE_LIMIT_REQUESTS=60
PREVIEW_RATE_LIMIT_WINDOW_S=300


# Stored run creation: authenticated-user based.
# Default: 60 requests per hour.
RUN_CREATE_RATE_LIMIT_REQUESTS=60
RUN_CREATE_RATE_LIMIT_WINDOW_S=3600


# Optimization execution: authenticated-user based.
# Default: 12 requests per hour.
EXECUTE_RATE_LIMIT_REQUESTS=12
EXECUTE_RATE_LIMIT_WINDOW_S=3600


# Ordinary authenticated reads.
# Default: 120 requests per minute.
AUTH_READ_RATE_LIMIT_REQUESTS=120
AUTH_READ_RATE_LIMIT_WINDOW_S=60
